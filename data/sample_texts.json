{
  "_comment": "Synthetic inbound texts for parser development (Phase 3). expected_intent is a development hint, not an eval pass criterion — real eval cases live in /evals/cases. Intents: cancel, accept, decline, partial, availability, question, confirm, other, unclear. sensitive marks messages that must escalate to the pastor.",
  "texts": [
    {"text": "cant make it tmrw sorry!!", "expected_intent": "cancel"},
    {"text": "which sunday?", "expected_intent": "question"},
    {"text": "i can but only til 10:30", "expected_intent": "partial"},
    {"text": "Y", "expected_intent": "accept"},
    {"text": "yes!!", "expected_intent": "accept"},
    {"text": "who is this", "expected_intent": "question"},
    {"text": "not this month", "expected_intent": "availability"},
    {"text": "2nd and 4th", "expected_intent": "availability"},
    {"text": "same as usual", "expected_intent": "availability"},
    {"text": "STOP", "expected_intent": "other"},
    {"text": "my dad was just taken to the ER, can't come", "expected_intent": "cancel", "sensitive": true},
    {"text": "I'm not doing well and don't want to be around anyone", "expected_intent": "cancel", "sensitive": true},
    {"text": "I finished the safety training last week so put me in nursery", "expected_intent": "other"},
    {"text": "sorry can't do sunday", "expected_intent": "cancel"},
    {"text": "yes I can help", "expected_intent": "accept"},
    {"text": "no sorry", "expected_intent": "decline"},
    {"text": "maybe? have to check with my wife", "expected_intent": "unclear"},
    {"text": "What time does it start?", "expected_intent": "question"},
    {"text": "I'll be there", "expected_intent": "confirm"},
    {"text": "C", "expected_intent": "confirm"},
    {"text": "X", "expected_intent": "cancel"},
    {"text": "can i switch to the 11?", "expected_intent": "other"},
    {"text": "we're out of town oct 18", "expected_intent": "availability"},
    {"text": "sure thing 👍", "expected_intent": "accept"},
    {"text": "START", "expected_intent": "other"},
    {"text": "who's preaching this week", "expected_intent": "question"},
    {"text": "My mom passed away last night. I can't come Sunday.", "expected_intent": "cancel", "sensitive": true},
    {"text": "in the hospital with my son, prayers appreciated", "expected_intent": "other", "sensitive": true},
    {"text": "I can do first and third sundays", "expected_intent": "availability"},
    {"text": "all sundays work except the 11th", "expected_intent": "availability"},
    {"text": "only mornings", "expected_intent": "availability"},
    {"text": "cant do nursery anymore, too much for me right now", "expected_intent": "other"},
    {"text": "yes but I have to leave by 10:30", "expected_intent": "partial"},
    {"text": "is this the church?", "expected_intent": "question"},
    {"text": "wrong number", "expected_intent": "other"},
    {"text": "thanks!", "expected_intent": "other"},
    {"text": "🙏", "expected_intent": "unclear"},
    {"text": "ok", "expected_intent": "unclear"},
    {"text": "I never signed up for this", "expected_intent": "other"},
    {"text": "can Jen cover for me?", "expected_intent": "cancel"},
    {"text": "running 15 min late today", "expected_intent": "other"},
    {"text": "surgery next week so I'm out for the month", "expected_intent": "cancel", "sensitive": true},
    {"text": "actually I can make it after all", "expected_intent": "other"}
  ]
}
