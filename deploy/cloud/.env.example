# Copy to .env in this directory. Never commit the filled file.
# Keep these switches false. Google Voice automation remains blocked by provider policy.
AUTOMATION_ENABLED=false
LIVE_SMS=false
GOOGLE_VOICE_ENABLED=false
ALLOW_TEXT_SIGNUP=false
PROFILE_SYNC_ENABLED=false
PCO_STAFFING_WRITE_ENABLED=false
PCO_STAFFING_POLL_ENABLED=false
COMPETITION_CONFIRMATION_REQUIRED=true
# Cloud replies always require Gloo; this also enables the signup admin flow.
GLOO_SIGNUP_REPLIES=true

# Generate three DIFFERENT random values (32+ bytes recommended). No defaults.
VOICE_API_TOKEN=
BACKEND_BRIDGE_KEY=
ADMIN_PASSWORD=

# Reserved sender metadata; optional while disconnected and cannot enable automation.
VOICE_EXPECTED_EMAIL=
VOICE_EXPECTED_NUMBER=
ADMIN_EMAIL_ALLOWLIST=
SUPERADMIN_EMAIL_ALLOWLIST=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
ADMIN_SITE_URL=
# Dedicated backend HTTPS origin, later used as the experiment Worker secret.
BACKEND_URL=
GLOO_API_KEY=
GLOO_ENDPOINT=guarded
CHURCH_TIMEZONE=America/Denver

# Keep recipient and session scope empty. This provider cannot deliver automated texts.
GOOGLE_VOICE_DEMO_PHONES=
GOOGLE_VOICE_TEST_SESSIONS=
GOOGLE_VOICE_MAX_QUEUE_AGE_SECONDS=900

# Override only for isolated local checks; the backend binds loopback only.
CLOUD_BACKEND_PORT=8000
# Optional named Cloudflare tunnel, activated separately with --profile tunnel.
CLOUDFLARE_TUNNEL_CONFIG=./private/tunnel.yml
CLOUDFLARE_TUNNEL_CREDENTIALS=./private/tunnel.json
