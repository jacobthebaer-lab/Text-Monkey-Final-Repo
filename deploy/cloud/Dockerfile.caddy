# The official image has not yet published 2.11.7. Retain its multiarch runtime
# and install the official fixed binary, checked against the release SHA512 list.
FROM caddy:2.11.6-alpine@sha256:d44355d3c2149dc580ce2cac735955d1c08d3d00882c30489c241aa51a5c10d9
ARG TARGETARCH
RUN case "$TARGETARCH" in \
      amd64) release_hash=a7a433a1b133efc3c8d10eb0b99d52a24b5ef5c322dc77f5282182b1c0402139ab83f3a99f0c52409df77d20123fb0b523edad8a66d8f5e49136197bf61ef0e7 ;; \
      arm64) release_hash=3db36ba90c7a6e8dda40ee3dd71fa08844c76b5fb08f61b31e5e78d2ed38e71c51dc7baed875e50d1ca1279196e84302967237386ae87c91ae9f2aaceada682e ;; \
      *) exit 1 ;; \
    esac \
    && wget -q -O /tmp/caddy.tar.gz "https://github.com/caddyserver/caddy/releases/download/v2.11.7/caddy_2.11.7_linux_${TARGETARCH}.tar.gz" \
    && printf '%s  /tmp/caddy.tar.gz\n' "$release_hash" | sha512sum -c - \
    && tar -xzf /tmp/caddy.tar.gz -C /usr/bin caddy \
    && rm /tmp/caddy.tar.gz \
    && caddy version | grep -q '^v2\.11\.7 '
