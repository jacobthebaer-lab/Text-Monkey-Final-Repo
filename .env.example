GLOO_API_KEY=
GLOO_ENDPOINT=guarded
AGENT_MODEL=gloo-anthropic-claude-sonnet-4.6
PARSER_MODEL=gloo-openai-gpt-5-mini
MAX_AGENT_STEPS=15
SMS_PROVIDER=mock            # mock | mac_messages | google_voice | twilio
LIVE_SMS=false               # required for Google Voice dispatch or live Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
CHURCH_TIMEZONE=America/Denver
ADMIN_PASSWORD=
DEMO_MODE=true
# Pause all background search/delivery jobs while building against shared data.
AUTOMATION_ENABLED=false
PUBLIC_BASE_URL=             # for Twilio webhook (e.g., ngrok or deployed URL)
DATABASE_URL=sqlite:///./servfrictionless.db

# Text Monkey admin dashboard. Supabase login is independent of volunteer phone profiles.
ALLOW_TEXT_SIGNUP=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
ADMIN_EMAIL_ALLOWLIST=
BACKEND_BRIDGE_KEY=
MAC_BRIDGE_ENABLED=false
GLOO_SIGNUP_REPLIES=false
MAC_TEST_SIGNUP_REPLY_UNTIL=
MAC_BRIDGE_TOKEN=
MAC_DEMO_PHONES=

# Approved destination for administrator confirmation and reset emails
ADMIN_SITE_URL=http://127.0.0.1:8000/texty

# Planning Center: explicit import scope, inactive without private credentials
PCO_APP_ID=
PCO_SECRET=
PCO_ORGANIZATION_ID=
PCO_SERVICE_TYPE_IDS=
PCO_WEBHOOK_SECRET=

PCO_WEBHOOK_SECRETS=  # comma-separated signing secrets for per-event subscriptions

# Experimental cloud Google Voice transport. See docs/CLOUD_GOOGLE_VOICE.md.
# Superadmins must ALSO be confirmed Supabase users in ADMIN_EMAIL_ALLOWLIST.
SUPERADMIN_EMAIL_ALLOWLIST=
GOOGLE_VOICE_ENABLED=false
GOOGLE_VOICE_CONNECTOR_URL=http://google-voice:8765
GOOGLE_VOICE_CONNECTOR_TOKEN=
GOOGLE_VOICE_EXPECTED_EMAIL=
GOOGLE_VOICE_EXPECTED_NUMBER=
GOOGLE_VOICE_DEMO_PHONES=
GOOGLE_VOICE_TEST_SESSIONS=
GOOGLE_VOICE_MAX_QUEUE_AGE_SECONDS=900
COMPETITION_CONFIRMATION_REQUIRED=false
