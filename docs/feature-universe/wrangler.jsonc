{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "text-monkey-universe-dev",
  "account_id": "eff4ab528a3709e98e38bc93ea73246f",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-03",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "FEATURE_STATUS",
      "id": "64dd0da582f84abe99bfe719502b56e6"
    }
  ]
}
